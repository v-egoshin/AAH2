{
  "name": "appsec-workbench",
  "displayName": "AppSec Workbench",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "*",
    "onStartupFinished",
    "onView:appsecContext",
    "onView:appsecChecks2",
    "onView:appsecLinkedEntities",
    "onCommand:appsecWorkbench.refreshContext",
    "onCommand:appsecWorkbench.refreshLinkedEntities",
    "onCommand:appsecWorkbench.selectCheckInChecks",
    "onCommand:appsecWorkbench.createAssessment",
    "onCommand:appsecWorkbench.setRecentMarkFilter",
    "onCommand:appsecWorkbench.clearRecentMarkFilter",
    "onCommand:appsecWorkbench.showSelectionActions",
    "onCommand:appsecWorkbench.markNote",
    "onCommand:appsecWorkbench.markAny",
    "onCommand:appsecWorkbench.markSource",
    "onCommand:appsecWorkbench.markSink",
    "onCommand:appsecWorkbench.markGuard",
    "onCommand:appsecWorkbench.markTransform",
    "onCommand:appsecWorkbench.createCheckFromSelection",
    "onCommand:appsecWorkbench.attachEvidenceFromSelection",
    "onCommand:appsecWorkbench.createCaseFromContext",
    "onCommand:appsecWorkbench.removeCurrentMark",
    "onCommand:appsecWorkbench.showRecentMarkActions",
    "onCommand:appsecWorkbench.setCheckStatus",
    "onCommand:appsecWorkbench.convertCheckToFinding",
    "onCommand:appsecWorkbench.toggleMarkDeadEnd",
    "onCommand:appsecWorkbench.dismissFollowUp",
    "onCommand:appsecWorkbench.openEntitySource",
    "onCommand:appsecWorkbench.acceptCandidate",
    "onCommand:appsecWorkbench.rejectCandidate",
    "onCommand:appsecWorkbench.setMarkDescriptionFromSelection",
    "onCommand:appsecWorkbench.saveMarkDescription",
    "onCommand:appsecWorkbench.cancelMarkDescription"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "appsecWorkbench",
          "title": "AppSec",
          "icon": "media/source.svg"
        }
      ]
    },
    "views": {
      "appsecWorkbench": [
        {
          "id": "appsecContext",
          "name": "AppSec Context",
          "type": "webview"
        },
        {
          "id": "appsecChecks2",
          "name": "AppSec Checks",
          "type": "webview"
        },
        {
          "id": "appsecLinkedEntities",
          "name": "Linked Entities",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "AppSec Workbench",
      "properties": {
        "appsecWorkbench.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:8000/api"
        },
        "appsecWorkbench.debugLogs": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose extension debug logs in the AppSec Workbench output channel."
        }
      }
    },
    "commands": [
      {
        "command": "appsecWorkbench.refreshContext",
        "title": "AppSec: Refresh Context"
      },
      {
        "command": "appsecWorkbench.refreshLinkedEntities",
        "title": "AppSec: Refresh Linked Entities"
      },
      {
        "command": "appsecWorkbench.selectCheckInChecks",
        "title": "AppSec: Select Check In Checks"
      },
      {
        "command": "appsecWorkbench.createAssessment",
        "title": "AppSec: Create Assessment"
      },
      {
        "command": "appsecWorkbench.setRecentMarkFilter",
        "title": "AppSec: Filter Recent Marks"
      },
      {
        "command": "appsecWorkbench.clearRecentMarkFilter",
        "title": "AppSec: Clear Recent Mark Filter"
      },
      {
        "command": "appsecWorkbench.showSelectionActions",
        "title": "AppSec: Show Selection Actions"
      },
      {
        "command": "appsecWorkbench.markNote",
        "title": "AppSec: Mark"
      },
      {
        "command": "appsecWorkbench.markSource",
        "title": "AppSec: Mark as Source"
      },
      {
        "command": "appsecWorkbench.markSink",
        "title": "AppSec: Mark as Sink"
      },
      {
        "command": "appsecWorkbench.markGuard",
        "title": "AppSec: Mark as Guard"
      },
      {
        "command": "appsecWorkbench.markTransform",
        "title": "AppSec: Mark as Transform"
      },
      {
        "command": "appsecWorkbench.createCheckFromSelection",
        "title": "AppSec: Create Check From Selection"
      },
      {
        "command": "appsecWorkbench.attachEvidenceFromSelection",
        "title": "AppSec: Attach Evidence From Selection"
      },
      {
        "command": "appsecWorkbench.openEntitySource",
        "title": "AppSec: Open Entity Source"
      },
      {
        "command": "appsecWorkbench.showLogs",
        "title": "AppSec: Show Logs"
      },
      {
        "command": "appsecWorkbench.acceptCandidate",
        "title": "AppSec: Accept Candidate"
      },
      {
        "command": "appsecWorkbench.rejectCandidate",
        "title": "AppSec: Reject Candidate"
      },
      {
        "command": "appsecWorkbench.createCaseFromContext",
        "title": "AppSec: Create Case From Context"
      },
      {
        "command": "appsecWorkbench.removeCurrentMark",
        "title": "AppSec: Remove Current Mark"
      },
      {
        "command": "appsecWorkbench.showRecentMarkActions",
        "title": "AppSec: Show Recent Mark Actions"
      },
      {
        "command": "appsecWorkbench.setCheckStatus",
        "title": "AppSec: Set Check Status"
      },
      {
        "command": "appsecWorkbench.convertCheckToFinding",
        "title": "AppSec: Convert Check To Finding"
      },
      {
        "command": "appsecWorkbench.dismissFollowUp",
        "title": "AppSec: Dismiss Follow-Up"
      },
      {
        "command": "appsecWorkbench.toggleMarkDeadEnd",
        "title": "AppSec: Toggle Dead End"
      },
      {
        "command": "appsecWorkbench.setMarkDescriptionFromSelection",
        "title": "AppSec: Set Mark Description"
      },
      {
        "command": "appsecWorkbench.saveMarkDescription",
        "title": "AppSec: Save Mark Description",
        "icon": "$(check)"
      },
      {
        "command": "appsecWorkbench.cancelMarkDescription",
        "title": "AppSec: Cancel Mark Description",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "comments/commentThread/title": [
        {
          "command": "appsecWorkbench.saveMarkDescription",
          "when": "commentController == appsec-mark-description",
          "group": "navigation@1"
        },
        {
          "command": "appsecWorkbench.cancelMarkDescription",
          "when": "commentController == appsec-mark-description",
          "group": "navigation@2"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "appsecWorkbench.markNote",
          "group": "appsec@1"
        },
        {
          "command": "appsecWorkbench.markSource",
          "group": "appsec@2"
        },
        {
          "command": "appsecWorkbench.markSink",
          "group": "appsec@3"
        },
        {
          "command": "appsecWorkbench.markGuard",
          "group": "appsec@4"
        },
        {
          "command": "appsecWorkbench.markTransform",
          "group": "appsec@5"
        },
        {
          "command": "appsecWorkbench.showSelectionActions",
          "group": "appsec@6"
        }
      ],
      "editor/context": [
        {
          "command": "appsecWorkbench.showSelectionActions",
          "group": "appsec@1",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "build:webview-linked-entities": "vite build --config webview-linked-entities/vite.config.ts",
    "build:all": "npm run build && npm run build:webview-linked-entities",
    "deploy:local": "../scripts/deploy_vscode_extension.sh"
  },
  "devDependencies": {
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
